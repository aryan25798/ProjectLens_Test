<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ProjectLens Automation Suite" parallel="none">
    <listeners>
        <listener class-name="com.example.listeners.TestListener"/>
    </listeners>
    <test name="Login Module Tests">
        <classes>
            <class name="com.example.tests.LoginTest"/>
        </classes>
    </test>
    <test name="Trainer Review Workflow Tests">
        <classes>
            <class name="com.example.tests.TrainerReviewTest"/>
        </classes>
    </test>
    <test name="Form Validation Module Tests">
        <classes>
            <class name="com.example.tests.FormValidationTest"/>
        </classes>
    </test>
    <test name="Notification Module Tests">
        <classes>
            <class name="com.example.tests.NotificationTest"/>
        </classes>
    </test>
    <test name="Revise Submission Workflow Tests">
        <classes>
            <class name="com.example.tests.ReviseSubmissionTest"/>
        </classes>
    </test>
</suite>
